<%- include("../partials/header") %>

<section class="hero">

    <div class="hero-eyebrow">
        PROMOTION MERN 2026/2027
    </div>

    <h1>
        Trouvez votre stage ou alternance
    </h1>

    <p id="total-count-text">
        <%= offers.length %> offres disponibles
    </p>

</section>


<form class="search-bar" method="GET" action="/offers">

    <input
        type="text"
        class="search-input"
        name="search"
        value="<%= search || '' %>"
        placeholder="Titre, entreprise, description..."
    >

    <select
        class="filter-select"
        name="type"
    >
        <option value="">Tout type</option>

        <option
            value="Stage"
            <%= type === "Stage" ? "selected" : "" %>
        >
            Stage
        </option>

        <option
            value="CDD"
            <%= type === "CDD" ? "selected" : "" %>
        >
            CDD
        </option>

        <option
            value="CDI"
            <%= type === "CDI" ? "selected" : "" %>
        >
            CDI
        </option>
    </select>


    <select
        class="filter-select"
        name="city"
    >
        <option value="">Toutes villes</option>

        <option
            value="Casablanca"
            <%= city === "Casablanca" ? "selected" : "" %>
        >
            Casablanca
        </option>

        <option
            value="Rabat"
            <%= city === "Rabat" ? "selected" : "" %>
        >
            Rabat
        </option>

        <option
            value="Marrakech"
            <%= city === "Marrakech" ? "selected" : "" %>
        >
            Marrakech
        </option>

        <option
            value="Tanger"
            <%= city === "Tanger" ? "selected" : "" %>
        >
            Tanger
        </option>

        <option
            value="Agadir"
            <%= city === "Agadir" ? "selected" : "" %>
        >
            Agadir
        </option>
    </select>


    <select
        class="filter-select"
        name="tech"
    >
        <option value="">Toutes techs</option>

        <% technologies.forEach(technology => { %>

            <option
                value="<%= technology.id %>"
                <%= String(tech) === String(technology.id) ? "selected" : "" %>
            >
                <%= technology.nom %>
            </option>

        <% }) %>
    </select>


    <button type="submit" class="btn-dark">
        Rechercher
    </button>

</form>


<main class="listings" id="listings">

    <% if (offers.length === 0) { %>

        <p class="empty-message">
            Aucune offre disponible.
        </p>

    <% } else { %>

        <% offers.forEach(offer => { %>

            <%- include("../partials/offer-card", { offer }) %>

        <% }) %>

    <% } %>

</main>


<script src="/js/followed.js"></script>

<%- include("../partials/footer") %>