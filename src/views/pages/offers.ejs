<%- include("../partials/header") %>

<section class="hero">

    <div class="hero-eyebrow">
        PROMOTION MERN 2026/2027
    </div>

    <h1>
        Trouvez votre stage ou alternance
    </h1>

    <p id="total-count-text">
        <%= offers.length %> offres disponibles
    </p>

</section>


<div class="search-bar">

    <input
        type="text"
        class="search-input"
        id="searchInput"
        placeholder="Titre, entreprise, description..."
    >

    <select
        class="filter-select"
        id="type-filter"
    >
        <option value="">Tout type</option>
    </select>

    <select
        class="filter-select"
        id="city-filter"
    >
        <option value="">Toutes villes</option>
    </select>

    <select
        class="filter-select"
        id="tech-filter"
    >
        <option value="">Toutes techs</option>
    </select>

</div>


<main class="listings" id="listings">

    <% if (offers.length === 0) { %>

        <p class="empty-message">
            Aucune offre disponible.
        </p>

    <% } else { %>

        <% offers.forEach(offer => { %>

            <%- include("../partials/offer-card", { offer }) %>

        <% }) %>

    <% } %>

</main>


<%- include("../partials/footer") %>