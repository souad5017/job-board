<%- include("../../partials/header") %>

<div class="admin-page">

    <div class="admin-header">

        <div>
            <h1>Administration</h1>

            <p class="page-sub">
                Ajouter une nouvelle offre
            </p>
        </div>

    </div>


    <form
        class="admin-form-panel"
        action="/admin/offers"
        method="POST"
    >

        <h2>Nouvelle offre</h2>


        <div class="admin-form-grid">


            <div class="admin-form-group">

                <label for="titre">
                    Titre <span class="required">*</span>
                </label>

                <input
                    type="text"
                    id="titre"
                    name="titre"
                    placeholder="Titre du poste"
                    required
                >

            </div>


            <div class="admin-form-group">

                <label for="entreprise_id">
                    Entreprise <span class="required">*</span>
                </label>

                <select
                    id="entreprise_id"
                    name="entreprise_id"
                    required
                >

                    <option value="">
                        Sélectionner une entreprise
                    </option>

                    <% companies.forEach(company => { %>

                        <option value="<%= company.id %>">
                            <%= company.nom %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <div class="admin-form-group">

                <label for="ville">
                    Ville <span class="required">*</span>
                </label>

                <input
                    type="text"
                    id="ville"
                    name="ville"
                    placeholder="ex : Casablanca"
                    required
                >

            </div>


            <div class="admin-form-group">

                <label for="type_contrat">
                    Type de contrat <span class="required">*</span>
                </label>

                <select
                    id="type_contrat"
                    name="type_contrat"
                    required
                >

                    <option value="">
                        Sélectionner
                    </option>

                    <option value="Stage">
                        Stage
                    </option>

                    <option value="CDI">
                        CDI
                    </option>

                    <option value="CDD">
                        CDD
                    </option>

                </select>

            </div>
            <div class="admin-form-group full">

    <label>Technologies</label>

    <div class="technology-list">

        <% technologies.forEach(technology => { %>

            <label class="technology-item">

                <input
                    type="checkbox"
                    name="technologies"
                    value="<%= technology.id %>"
                >

                <span>
                    <%= technology.nom %>
                </span>

            </label>

        <% }) %>

    </div>

</div>


            <div class="admin-form-group full">

                <label for="description">
                    Description <span class="required">*</span>
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="7"
                    placeholder="Description complète de la mission"
                    required
                ></textarea>

            </div>


        </div>


        <div class="admin-form-actions">

            <a
                href="/admin"
                class="btn-outline"
            >
                Annuler
            </a>

            <button
                type="submit"
                class="btn-dark"
            >
                Créer l'offre
            </button>

        </div>

    </form>

</div>

<%- include("../../partials/footer") %>