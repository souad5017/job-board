
<%- include("../../partials/header") %>

<div class="admin-page">

    <div class="admin-header">

        <div>
            <h1>Administration</h1>

            <p class="page-sub">
                <%= offers.length %> offres publiées
            </p>
        </div>

        <a href="/admin/offers/new" class="btn-dark">
            + Ajouter une offre
        </a>

    </div>


    <div class="admin-table-wrap">

        <table class="admin-table">

            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Ville</th>
                    <th>Type</th>
                    <th>Publication</th>
                    <th></th>
                </tr>
            </thead>


            <tbody>

                <% offers.forEach(offer => { %>
                <%
    const date = new Date(offer.date_publication)

    const dateForm = date.toLocaleDateString("fr-FR", {
        day: "numeric",
        month: "short",
        year: "numeric"
    })
%>

                    <tr>

                        <td>
                            <%= offer.titre %>
                        </td>

                        <td class="muted">
                            <%= offer.entreprise_nom %>
                        </td>

                        <td class="muted">
                            <%= offer.ville %>
                        </td>

                        <td>

                            <span class="tag stage">
                                <%= offer.type_contrat %>
                            </span>

                        </td>

                        <td class="muted">
                            <%= dateForm %>
                        </td>

                        <td class="actions">

                            <a
                                href="/offers/<%= offer.id %>"
                                class="action-link"
                            >
                                Voir
                            </a>

                            <a
                                href="/admin/offers/<%= offer.id %>/edit"
                                class="action-link"
                            >
                                Modifier
                            </a>

                            <form
                                action="/admin/offers/<%= offer.id %>/delete"
                                method="POST"
                                style="display: inline;"
                            >
                                <button
                                    type="submit"
                                    class="action-link danger"
                                >
                                    Supprimer
                                </button>
                            </form>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

<%- include("../../partials/footer") %>